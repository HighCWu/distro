{
  "name": "@lowland/kernel",
  "version": "0.0.0",
  "description": "Low-level Linux virtual machine and virtio device primitives for JavaScript.",
  "homepage": "https://linux.tombl.dev/reference/kernel/",
  "license": "MIT AND (GPL-2.0-only WITH Linux-syscall-note)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tombl/distro.git",
    "directory": "packages/kernel"
  },
  "files": [
    "dist",
    "vmlinux.wasm",
    "linux-build",
    "src/virtio/ninep/LICENSE.MIT"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./ninep": {
      "types": "./dist/ninep.d.ts",
      "default": "./dist/ninep.js"
    },
    "./ninep/node": {
      "types": "./dist/virtio/ninep/node-directory-snapshot.d.ts",
      "node": "./dist/virtio/ninep/node-directory-snapshot.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit && tsc -p test",
    "test": "node --test"
  },
  "dependencies": {
    "@lowland/bytes": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26",
    "typescript": "^7"
  },
  "bundledDependencies": [
    "@lowland/bytes"
  ]
}
