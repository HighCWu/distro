+#if defined(__wasm__)
+struct uv__thread_start_info {
+  void (*entry)(void *arg);
+  void *arg;
+};
+
+static void *uv__thread_start(void *arg) {
+  struct uv__thread_start_info *info;
+  void (*entry)(void *arg);
+  void *entry_arg;
+
+  info = arg;
+  entry = info->entry;
+  entry_arg = info->arg;
+  uv__free(info);
+  entry(entry_arg);
+  return NULL;
+}
+#endif
+
 int uv_thread_detach(uv_thread_t *tid) {
   return UV__ERR(pthread_detach(*tid));
 }
