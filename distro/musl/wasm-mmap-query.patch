# Query main-module static data/BSS, the linked stack, and Wasm mmap records.
--- a/src/mman/mmap.c
+++ b/src/mman/mmap.c
@@ -47,6 +47,107 @@
 
 static pthread_mutex_t mappings_lock = PTHREAD_MUTEX_INITIALIZER;
 static struct wasm_mapping *mappings;
+
+extern uintptr_t __wasm_brk_layout_v1(void);
+extern char __stack_low __attribute__((__weak__, __visibility__("hidden")));
+extern char __stack_high __attribute__((__weak__, __visibility__("hidden")));
+
+/* Linker ranges are resident without mmap records. Round each range to
+ * Linux's 64 KiB pages without extending it into the rest of linear memory. */
+static int wasm_linked_page_range(uintptr_t low, uintptr_t high,
+				  uintptr_t *begin, uintptr_t *end)
+{
+	uintptr_t rounded_end;
+	uintptr_t page_mask = (uintptr_t)PAGESIZE - 1;
+
+	if (high < low)
+		return -EINVAL;
+	if (low == high) {
+		*begin = *end = high;
+		return 0;
+	}
+	*begin = low & ~page_mask;
+	rounded_end = high & ~page_mask;
+	if (high & page_mask) {
+		if (rounded_end > UINTPTR_MAX - PAGESIZE)
+			return -EINVAL;
+		rounded_end += PAGESIZE;
+	}
+	if (rounded_end < *begin)
+		return -EINVAL;
+	*end = rounded_end;
+	return 0;
+}
+
+/* Union the published mmap records with the main module's linked ranges,
+ * returning only the contiguous covered prefix. */
+__attribute__((export_name("__wasm_mmap_query_v1")))
+long __wasm_mmap_query_v1(uintptr_t address, size_t pages)
+{
+	uintptr_t end, cursor, static_begin, static_end, stack_begin, stack_end;
+	uintptr_t layout_address;
+	const uintptr_t *layout;
+	size_t bytes;
+	struct wasm_mapping *current;
+	int error, lock_error, unlock_error;
+
+	if (!pages)
+		return 0;
+	if ((address & (PAGESIZE - 1)) || pages > SIZE_MAX / PAGESIZE)
+		return -EINVAL;
+	bytes = pages * PAGESIZE;
+	if (bytes > UINTPTR_MAX - address)
+		return -EINVAL;
+	end = address + bytes;
+	layout_address = __wasm_brk_layout_v1();
+	if (!layout_address)
+		return -EINVAL;
+	layout = (const uintptr_t *)layout_address;
+	error = wasm_linked_page_range(layout[1], layout[2],
+				       &static_begin, &static_end);
+	if (error)
+		return error;
+	/* Both weak bounds are equal in a shared module with no linked stack. */
+	error = wasm_linked_page_range((uintptr_t)&__stack_low,
+				       (uintptr_t)&__stack_high,
+				       &stack_begin, &stack_end);
+	if (error)
+		return error;
+
+	lock_error = pthread_mutex_lock(&mappings_lock);
+	if (lock_error)
+		return lock_error > 0 ? -lock_error : -EINVAL;
+
+	cursor = address;
+	while (cursor < end) {
+		uintptr_t covered_end = cursor;
+		if (static_begin <= cursor && cursor < static_end)
+			covered_end = static_end;
+		if (stack_begin <= cursor && cursor < stack_end && stack_end > covered_end)
+			covered_end = stack_end;
+
+		for (current = mappings; current; current = current->next) {
+			uintptr_t mapping_begin = (uintptr_t)current->address;
+			uintptr_t mapping_end;
+
+			if (!current->length ||
+			    current->length > UINTPTR_MAX - mapping_begin)
+				continue;
+			mapping_end = mapping_begin + current->length;
+			if (mapping_begin <= cursor && cursor < mapping_end &&
+			    mapping_end > covered_end)
+				covered_end = mapping_end;
+		}
+		if (covered_end == cursor)
+			break;
+		cursor = covered_end < end ? covered_end : end;
+	}
+
+	unlock_error = pthread_mutex_unlock(&mappings_lock);
+	if (unlock_error)
+		return unlock_error > 0 ? -unlock_error : -EINVAL;
+	return (long)((cursor - address) / PAGESIZE);
+}
 
