# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
# Linux/Wasm shared objects use the main module runtime and relocated table.
--- a/clang/lib/Driver/ToolChains/WebAssembly.cpp
+++ b/clang/lib/Driver/ToolChains/WebAssembly.cpp
@@ -114,6 +114,8 @@
   ToolChain.AddFilePathLibArgs(Args, CmdArgs);
 
   bool IsCommand = true;
+  const bool IsLinuxShared = ToolChain.getTriple().isOSLinux() &&
+                             Args.hasArg(options::OPT_shared);
   const char *Crt1;
   const char *Entry = nullptr;
 
@@ -153,8 +155,14 @@
     }
   }
 
-  if (!Args.hasArg(options::OPT_nostdlib, options::OPT_nostartfiles))
+  if (!IsLinuxShared &&
+      !Args.hasArg(options::OPT_nostdlib, options::OPT_nostartfiles)) {
+    if (ToolChain.getTriple().isOSLinux())
+      CmdArgs.push_back("--whole-archive");
     CmdArgs.push_back(Args.MakeArgString(ToolChain.GetFilePath(Crt1)));
+    if (ToolChain.getTriple().isOSLinux())
+      CmdArgs.push_back("--no-whole-archive");
+  }
   if (Entry) {
     CmdArgs.push_back(Args.MakeArgString("--entry"));
     CmdArgs.push_back(Args.MakeArgString(Entry));
@@ -162,11 +170,13 @@
 
   if (Args.hasArg(options::OPT_shared))
     CmdArgs.push_back(Args.MakeArgString("-shared"));
+  if (IsLinuxShared)
+    CmdArgs.push_back("--unresolved-symbols=import-dynamic");
 
   // Linux reserves function-pointer values 1 and 2 for SIG_IGN and SIG_HOLD.
   // Keep real address-taken functions out of those wasm table slots. Linker
   // inputs follow this default, so an explicit user --table-base wins.
-  if (ToolChain.getTriple().isOSLinux())
+  if (ToolChain.getTriple().isOSLinux() && !IsLinuxShared)
     CmdArgs.push_back("--table-base=3");
 
   AddLinkerInputs(ToolChain, Inputs, Args, CmdArgs, JA);
@@ -174,7 +184,19 @@
   if (WantsPthread(ToolChain.getTriple(), Args))
     CmdArgs.push_back("--shared-memory");
 
-  if (!Args.hasArg(options::OPT_nostdlib, options::OPT_nodefaultlibs)) {
+  // Linux/Wasm side modules share the main module's libc and runtime. Pulling
+  // static system archives into each side module duplicates process state.
+  if (!IsLinuxShared &&
+      !Args.hasArg(options::OPT_nostdlib, options::OPT_nodefaultlibs)) {
+    if (ToolChain.getTriple().isOSLinux()) {
+      const std::string ExportedLibc = ToolChain.GetFilePath("libc-exports.a");
+      if (ExportedLibc != "libc-exports.a" &&
+          llvm::sys::fs::exists(ExportedLibc)) {
+        CmdArgs.push_back("--whole-archive");
+        CmdArgs.push_back(Args.MakeArgString(ExportedLibc));
+        CmdArgs.push_back("--no-whole-archive");
+      }
+    }
     if (ToolChain.ShouldLinkCXXStdlib(Args))
       ToolChain.AddCXXStdlibLibArgs(Args, CmdArgs);
