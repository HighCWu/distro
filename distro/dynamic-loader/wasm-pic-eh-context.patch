 // Communication channel between compiler-generated user code and personality
 // function
 thread_local struct _Unwind_LandingPadContext __wasm_lpad_context;
+
+_LIBUNWIND_EXPORT struct _Unwind_LandingPadContext *
+_Unwind_GetWasmLPadContext(void) {
+  return &__wasm_lpad_context;
+}
 
 /// Calls to this function are in landing pads in compiler-generated user code.
 /// In other EH schemes, stack unwinding is done by libunwind library, which
--- /dev/null
+++ b/llvm/test/CodeGen/WebAssembly/wasm-pic-eh-context.ll
@@ -0,0 +1,40 @@
+; SPDX-License-Identifier: MIT
+; RUN: llc < %s -asm-verbose=false -wasm-enable-eh -wasm-use-legacy-eh=false -exception-model=wasm -mattr=+exception-handling -relocation-model=pic | FileCheck %s --check-prefix=PIC
+; RUN: llc < %s -asm-verbose=false -wasm-enable-eh -wasm-use-legacy-eh=false -exception-model=wasm -mattr=+exception-handling -relocation-model=static | FileCheck %s --check-prefix=NONPIC
+
+target triple = "wasm32-unknown-unknown"
+
+@_ZTIi = external dso_local constant ptr
+@selector = global i32 0
+
+declare void @foo()
+declare i32 @__gxx_wasm_personality_v0(...)
+declare ptr @llvm.wasm.get.exception(token)
+declare i32 @llvm.wasm.get.ehselector(token)
+
+define void @catch() personality ptr @__gxx_wasm_personality_v0 {
+entry:
+  invoke void @foo()
+          to label %exit unwind label %dispatch
+
+dispatch:
+  %0 = catchswitch within none [label %catch.start] unwind to caller
+
+catch.start:
+  %1 = catchpad within %0 [ptr @_ZTIi]
+  %2 = call ptr @llvm.wasm.get.exception(token %1)
+  %3 = call i32 @llvm.wasm.get.ehselector(token %1)
+  store volatile i32 %3, ptr @selector
+  catchret from %1 to label %exit
+
+exit:
+  ret void
+}
+
+; PIC-NOT: __wasm_lpad_context
+; PIC: call _Unwind_GetWasmLPadContext
+; PIC-NOT: __wasm_lpad_context
+
+; NONPIC-NOT: _Unwind_GetWasmLPadContext
+; NONPIC: __wasm_lpad_context
+; NONPIC-NOT: _Unwind_GetWasmLPadContext
