# Preserve explicitly requested function imports as true Wasm exports.
diff --git a/lld/test/wasm/function-reexports.s b/lld/test/wasm/function-reexports.s
new file mode 100644
index 0000000..3db6d49
--- /dev/null
+++ b/lld/test/wasm/function-reexports.s
@@ -0,0 +1,93 @@
+# SPDX-License-Identifier: MIT
+# RUN: split-file %s %t
+# RUN: llvm-mc -filetype=obj -triple=wasm32-unknown-unknown %t/provider.s -o %t/provider.o
+# RUN: wasm-ld -shared --experimental-pic -o %t/provider.so %t/provider.o
+# RUN: llvm-mc -filetype=obj -triple=wasm32-unknown-unknown %t/consumer.s -o %t/consumer.o
+# RUN: wasm-ld -shared --experimental-pic --no-export-dynamic --export=imported --export=defined -o %t/explicit.wasm %t/consumer.o %t/provider.so
+# RUN: obj2yaml %t/explicit.wasm | FileCheck %s --check-prefix=EXPLICIT
+# RUN: wasm-ld -shared --experimental-pic --no-export-dynamic --export-all -o %t/all.wasm %t/consumer.o %t/provider.so
+# RUN: obj2yaml %t/all.wasm | FileCheck %s --check-prefix=ALL
+# RUN: wasm-ld -shared --experimental-pic --no-export-dynamic --export-if-defined=imported -o %t/if-defined.wasm %t/consumer.o %t/provider.so
+# RUN: obj2yaml %t/if-defined.wasm | FileCheck %s --check-prefix=IF-DEFINED
+# RUN: llvm-mc -filetype=obj -triple=wasm32-unknown-unknown %t/got-only.s -o %t/got-only.o
+# RUN: wasm-ld -shared --experimental-pic --unresolved-symbols=import-dynamic --no-export-dynamic --export=got_only -o %t/got-only.wasm %t/got-only.o
+# RUN: obj2yaml %t/got-only.wasm | FileCheck %s --check-prefix=GOT
+# RUN: not wasm-ld -shared --experimental-pic --no-export-dynamic --export=got_only -o %t/unresolved.wasm %t/got-only.o 2>&1 | FileCheck %s --check-prefix=UNRESOLVED
+
+# The imported function is exported at its function import index, and the
+# defined function retains the normal explicit-export behavior.
+# EXPLICIT:        - Type:            IMPORT
+# EXPLICIT:          - Field:           imported
+# EXPLICIT-NEXT:       Kind:            FUNCTION
+# EXPLICIT-NEXT:       SigIndex:        {{[0-9]+}}
+# EXPLICIT:        - Type:            EXPORT
+# EXPLICIT:            - Name:            imported
+# EXPLICIT-NEXT:         Kind:            FUNCTION
+# EXPLICIT-NEXT:         Index:           0
+# EXPLICIT:            - Name:            defined
+# EXPLICIT-NEXT:         Kind:            FUNCTION
+# EXPLICIT-NEXT:         Index:           {{[0-9]+}}
+
+# --export-all still exports the module's own functions, without re-exporting
+# the function imported from provider.so.
+# ALL:              - Type:            EXPORT
+# ALL-NEXT:           Exports:
+# ALL-NOT:              - Name:            imported
+# ALL:                  - Name:            defined
+# ALL-NOT:              - Name:            imported
+
+# --export-if-defined does not request an imported symbol's re-export.
+# IF-DEFINED:       - Type:            EXPORT
+# IF-DEFINED-NEXT:    Exports:
+# IF-DEFINED-NOT:     - Name:            imported
+
+# A function referenced only by its address through PIC data is still emitted
+# as a function import when explicitly re-exported.
+# GOT:              - Type:            IMPORT
+# GOT:                - Field:           got_only
+# GOT-NEXT:            Kind:            FUNCTION
+# GOT:              - Type:            EXPORT
+# GOT:                - Name:            got_only
+# GOT-NEXT:             Kind:            FUNCTION
+# GOT-NEXT:             Index:           0
+
+# An unresolved function that is not allowed to import keeps the explicit
+# export diagnostic.
+# UNRESOLVED: error: symbol exported via --export not found: got_only
+
+#--- provider.s
+.globl imported
+imported:
+  .functype imported (i32) -> (i32)
+  local.get 0
+  i32.const 41
+  i32.add
+  end_function
+
+#--- consumer.s
+.globl imported
+.functype imported (i32) -> (i32)
+
+.globl defined
+defined:
+  .functype defined (i32) -> (i32)
+  local.get 0
+  i32.const 1
+  i32.add
+  end_function
+
+.globl use_imported
+use_imported:
+  .functype use_imported () -> (i32)
+  i32.const 1
+  call imported
+  end_function
+
+#--- got-only.s
+.globl got_only
+.functype got_only (i32) -> (i32)
+
+.section .data.address,"",@
+address:
+  .int32 got_only
+  .size address, 4
