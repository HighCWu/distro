diff --git a/lld/wasm/Symbols.cpp b/lld/wasm/Symbols.cpp
index f204044..3ce5bcf 100644
--- a/lld/wasm/Symbols.cpp
+++ b/lld/wasm/Symbols.cpp
@@ -203,8 +203,33 @@ bool Symbol::isImported() const {
          (isUndefined() && (importName.has_value() || forceImport));
 }
 
+static bool canReExportFunction(const Symbol *sym) {
+  if (!ctx.arg.shared || ctx.arg.relocatable || sym->isLocal())
+    return false;
+
+  if (auto *shared = dyn_cast<SharedFunctionSymbol>(sym))
+    return shared->signature != nullptr;
+
+  auto *undef = dyn_cast<UndefinedFunction>(sym);
+  if (!undef || !undef->signature || undef->isWeak())
+    return false;
+
+  // Re-exporting an undefined function is only valid when it is an actual
+  // import. In particular, don't turn a weak undefined function into a stub
+  // that looks callable to consumers.
+  return undef->isImported() || ctx.arg.importUndefined ||
+         ctx.arg.unresolvedSymbols == UnresolvedPolicy::ImportDynamic ||
+         ctx.arg.allowUndefinedSymbols.count(sym->getName()) != 0;
+}
+
 bool Symbol::isExported() const {
-  if (!isDefined() || isShared() || isLocal())
+  if (isLocal())
+    return false;
+
+  if (forceReExport && canReExportFunction(this))
+    return true;
+
+  if (!isDefined() || isShared())
     return false;
 
   // Shared libraries must export all weakly defined symbols
