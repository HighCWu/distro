Keep the POSIX dictionary loader and recognize mapping failures.

Linux/Wasm now supports private file mappings backed by real linear-memory
addresses. Do not force Wasm into the malloc fallback. POSIX mmap signals
failure with MAP_FAILED, not NULL; reject it before handing the dictionary
to the compressor. This source change remains under Zstandard's upstream
dual license; this package selects the BSD-3-Clause option.

diff --git a/programs/fileio.c b/programs/fileio.c
--- a/programs/fileio.c
+++ b/programs/fileio.c
@@ -777,7 +777,7 @@ static size_t FIO_setDictBufferMMap(FIO_Dict_t* dict, const char* fileName, FIO_prefs_t* const prefs, stat_t* dictFileStat)
 
     *bufferPtr = mmap(NULL, (size_t)fileSize, PROT_READ, MAP_PRIVATE, fileHandle, 0);
-    if (*bufferPtr==NULL) EXM_THROW(34, "%s", strerror(errno));
+    if (*bufferPtr==MAP_FAILED) EXM_THROW(34, "%s", strerror(errno));
 
     close(fileHandle);
     return (size_t)fileSize;
 }
