# SPDX-License-Identifier: MIT
CC = @CC@
CPPFLAGS = @CPPFLAGS@
CFLAGS = @CFLAGS@
LDFLAGS = @LDFLAGS@
LIBS = @LIBS@
DEFS = @DEFS@
srcdir = @srcdir@
EXEEXT = @EXEEXT@

.PHONY: all
all: sdk-autoconf$(EXEEXT)

main.o: $(srcdir)/main.c
	$(CC) $(DEFS) $(CPPFLAGS) $(CFLAGS) -c $(srcdir)/main.c -o $@

sdk-autoconf$(EXEEXT): main.o
	$(CC) $(CFLAGS) $(LDFLAGS) main.o $(LIBS) -o $@
