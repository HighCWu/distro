# SPDX-License-Identifier: MIT
CC = @CC@
CC_FOR_BUILD = @CC_FOR_BUILD@
CFLAGS_FOR_BUILD = @CFLAGS_FOR_BUILD@
CPPFLAGS = @CPPFLAGS@
CFLAGS = @CFLAGS@
LDFLAGS = @LDFLAGS@
LIBS = @LIBS@
DEFS = @DEFS@
srcdir = @srcdir@
EXEEXT = @EXEEXT@

.PHONY: all
all: sdk-autoconf$(EXEEXT)

sdk-generator: $(srcdir)/generator.c
	$(CC_FOR_BUILD) $(CFLAGS_FOR_BUILD) $(srcdir)/generator.c -o $@

generated.h: sdk-generator
	@set -e; trap 'rm -f "$@.tmp"' 0; \
	  ./sdk-generator > "$@.tmp"; mv "$@.tmp" "$@"

main.o: $(srcdir)/main.c generated.h
	$(CC) $(DEFS) $(CPPFLAGS) $(CFLAGS) -I. -c $(srcdir)/main.c -o $@

sdk-autoconf$(EXEEXT): main.o
	$(CC) $(CFLAGS) $(LDFLAGS) main.o $(LIBS) -o $@
