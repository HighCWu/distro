# SPDX-License-Identifier: MIT
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR "@wasmArch@")
set(CMAKE_C_COMPILER "@cc@")
set(CMAKE_CXX_COMPILER "@cxx@")
set(CMAKE_AR "@ar@")
set(CMAKE_RANLIB "@ranlib@")
set(CMAKE_SYSROOT "@sysroot@")
set(PKG_CONFIG_EXECUTABLE "@pkgConfig@" CACHE FILEPATH "Target metadata query tool")
# Do not append CMAKE_PREFIX_PATH (which may describe host tools) to .pc paths.
set(PKG_CONFIG_USE_CMAKE_PREFIX_PATH FALSE)
# Keep executable try_compile probes so missing symbols fail at link time.
# Cross-compilation does not execute them; try_run needs a target runtime.
set(CMAKE_FIND_ROOT_PATH "@sysroot@")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_EXECUTABLE_SUFFIX ".wasm")
# This SDK currently provides static target libraries only.
set_property(GLOBAL PROPERTY TARGET_SUPPORTS_SHARED_LIBS FALSE)
# Wasm has no ELF runtime library search path. In particular, Ninja must not
# attempt an install-time RPATH relink for dependencies found via pkg-config.
set(CMAKE_SKIP_RPATH TRUE CACHE BOOL "Wasm has no runtime library search path" FORCE)
